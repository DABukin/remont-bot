    response = requests.post(FORM_URL, data=data)\
\
    if response.status_code in (200, 302):\
        await update.message.reply_text("\uc0\u9989  \u1056 \u1072 \u1089 \u1093 \u1086 \u1076  \u1076 \u1086 \u1073 \u1072 \u1074 \u1083 \u1077 \u1085 !")\
