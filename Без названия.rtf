        await update.message.reply_text("\uc0\u10060  \u1054 \u1096 \u1080 \u1073 \u1082 \u1072  \u1087 \u1088 \u1080  \u1086 \u1090 \u1087 \u1088 \u1072 \u1074 \u1082 \u1077 .")\
\
    return ConversationHandler.END\
\
\
conv_handler = ConversationHandler(\
    entry_points=[CommandHandler("expense", expense_start)],\
    states=\{\
