\
\
async def start(update: Update, context: ContextTypes.DEFAULT_TYPE):\
    await update.message.reply_text(\
        "\uc0\u1055 \u1088 \u1080 \u1074 \u1077 \u1090  \u55357 \u56395 \\n\u1053 \u1072 \u1087 \u1080 \u1096 \u1080  /expense \u1095 \u1090 \u1086 \u1073 \u1099  \u1076 \u1086 \u1073 \u1072 \u1074 \u1080 \u1090 \u1100  \u1088 \u1072 \u1089 \u1093 \u1086 \u1076 ."\
    )\
\
\
